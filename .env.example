# Google Drive Data Source Configuration
DATA_SOURCE=drive
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
GOOGLE_DRIVE_DATA_FOLDER_ID=your-folder-id

# OAuth 2.0 Configuration (Recommended for Personal Accounts to enable uploads)
# You need GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, and GOOGLE_REFRESH_TOKEN instead of Service Account
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
# GOOGLE_REFRESH_TOKEN=...

# Local Data Source (Default if DATA_SOURCE is not set)
# DATA_SOURCE=fs
